#include <iostream>
#include <string>
#include <cctype>

using namespace std;


// Main password Validation
bool IsValidPassword(string UsrPsWd) {
    int PsWdGrd = 0;
    int NumCount = 0;
    bool HasCapital = false;
    bool HasSpcChar = false;
    //"Checks if password length is at least 8 characters."
    if (UsrPsWd.length() >= 8){
        PsWdGrd += 1;
        }
    else
    {
	    cout<<"Password must have at least 8 characters"<< endl;
    }
   //Counts numbers
    for (unsigned char ch : UsrPsWd){
    if (isdigit(ch)) {
        NumCount++;}
    if (isupper(static_cast<unsigned char>(ch))){
        HasCapital=true;}
    if (ispunct(static_cast<unsigned char>(ch))){
        HasSpcChar=true;}
    }   
        
    //Checks if password contains at least 2 numbers
    if (NumCount >= 2) {
        PsWdGrd += 1;} 
    else {
        cout << "Password must have at least 2 numbers." << endl;}
    //Checks if password contains at least 1 Capitalized Letter
    if (!HasCapital) {   
        cout<<"Password must have at least 1 capitalized letter."<< endl;}
    else {
        PsWdGrd += 1;}
    //Checks if password contains at least 1 special character.   
    if (!HasSpcChar){
        cout<<"Password must have at least 1 special character."<< endl;}
    else{
        PsWdGrd += 1;}  
    //"Final Check if password is valid"
    if (PsWdGrd == 4){
        return true;}
    else {
        return false;}
}
    //
int main() {

    string UsrPsWd;
    cout <<"Enter Password!(min. 8 Characters,2 Numbers,1 Capitalized Letter,1 special character.)" << endl;
    cin >> UsrPsWd;
    if (IsValidPassword(UsrPsWd)) {
        cout << "Password is valid." << endl;
    }
    else {
        cout << "Password is invalid." << endl;
    }

}
